# processlens — runs offline by default (deterministic analyst, no key).
# To use a real model through any OpenAI-compatible endpoint:
# PL_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=            <- from your shell / secret manager, never committed
# One model per stage — keep the critic different from the generator:
# PL_MODEL_GENERATE=
# PL_MODEL_CRITIC=
# PL_MODEL_QUESTIONNAIRE=
